<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AirPods"
        android:textColor="#8E8E93"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <LinearLayout style="@style/WidgetCell">
            <TextView style="@style/WidgetLabel" android:text="左耳" />
            <TextView android:id="@+id/left" style="@style/WidgetValue" />
        </LinearLayout>

        <LinearLayout style="@style/WidgetCell">
            <TextView style="@style/WidgetLabel" android:text="右耳" />
            <TextView android:id="@+id/right" style="@style/WidgetValue" />
        </LinearLayout>

        <LinearLayout style="@style/WidgetCell">
            <TextView style="@style/WidgetLabel" android:text="充電盒" />
            <TextView android:id="@+id/case_battery" style="@style/WidgetValue" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
